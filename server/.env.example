# LLM 프로바이더: api | codex | claude | mock
#   api     ANTHROPIC_API_KEY 로 직접 호출. 가장 빠르고 안정적. API 크레딧 필요.
#   codex   로그인된 codex CLI 를 호출. ChatGPT 구독으로 커버. API 키 불필요. 느림(10~20초).
#   claude  로그인된 claude CLI 를 호출. Claude 구독으로 커버. API 키 불필요. 느림.
#   mock    키도 CLI 도 없이 전체 흐름만 시연.
# 비워두면 ANTHROPIC_API_KEY 유무로 api / mock 자동 선택.
LLM_PROVIDER=

# LLM_PROVIDER=api 일 때만 필요
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# CLI 모드 옵션. 모델을 비우면 각 CLI 의 기본 모델을 씁니다.
LLM_CLI_MODEL=
LLM_CLI_TIMEOUT_MS=180000
# codex 추론 강도: low | medium | high. 기본 low (medium 대비 ~20% 빠르고 품질 차이 없음).
# minimal 은 tools 와 함께 쓸 수 없어 400 이 납니다.
LLM_CLI_EFFORT=low

# 선택: 임베딩 하이브리드 검색. 없으면 BM25 단독으로 동작합니다.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

PORT=8787
# 정책 마크다운 폴더 (Notion/Confluence 는 여기로 export 하거나 sync 스크립트를 붙이면 됩니다)
POLICY_DIR=./policies
